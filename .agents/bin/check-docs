#!/usr/bin/env python3
"""
Check that AGENTS.md and the docs under .agents/ only point at things that exist.

Checks two kinds of references:
- Repo paths in inline code, for example `mathesar/rpc/records.py`.
- Relative Markdown links, for example [text](../02-backend/rpc.md).

Usage: .agents/bin/check-docs
Exits 1 and lists each broken reference as file:line.
"""
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]
DOC_GLOBS = ["AGENTS.md", "CLAUDE.md", ".agents/**/*.md"]

INLINE_CODE = re.compile(r"`([^`\n]+)`")
MARKDOWN_LINK = re.compile(r"\[[^\]]*\]\(([^)\s]+)\)")
FENCE = re.compile(r"^\s*(```|~~~)")
NOT_A_LITERAL_PATH = re.compile(r"[\s*<>{}$|=,;()\[\]\"']|\.\.\.|:\D")
URL_SCHEME = re.compile(r"^[a-z][a-z0-9+.-]*:")


def git_lines(*args):
    result = subprocess.run(
        ["git", *args], cwd=REPO_ROOT, capture_output=True, text=True, check=True
    )
    return result.stdout.splitlines()


def is_git_ignored(path):
    # The trailing-slash form matches directory-only patterns for paths that do not exist yet.
    result = subprocess.run(
        ["git", "check-ignore", path, path + "/"], cwd=REPO_ROOT, capture_output=True
    )
    return bool(result.stdout.strip())


def repo_path_candidate(code, top_level_names):
    """Return the repo path that an inline code span names, or None."""
    if NOT_A_LITERAL_PATH.search(code) or URL_SCHEME.match(code):
        return None
    candidate = code.split("::")[0].split("#")[0]
    candidate = re.sub(r":\d+(-\d+)?$", "", candidate).rstrip("/.:")
    if "/" not in candidate or candidate.split("/")[0] not in top_level_names:
        return None
    return candidate


def lines_outside_code_fences(text):
    in_fence = False
    for line_number, line in enumerate(text.splitlines(), start=1):
        if FENCE.match(line):
            in_fence = not in_fence
            continue
        if not in_fence:
            yield line_number, line


def broken_references(doc, top_level_names):
    text = doc.read_text(encoding="utf-8")
    for line_number, line in lines_outside_code_fences(text):
        for code in INLINE_CODE.findall(line):
            candidate = repo_path_candidate(code, top_level_names)
            if candidate is None or is_git_ignored(candidate):
                continue
            if not (REPO_ROOT / candidate).exists():
                yield line_number, f"path does not exist: {candidate}"
        for target in MARKDOWN_LINK.findall(INLINE_CODE.sub("", line)):
            if URL_SCHEME.match(target) or target.startswith("#"):
                continue
            target_path = target.split("#")[0]
            if not (doc.parent / target_path).exists():
                yield line_number, f"link target does not exist: {target}"


def main():
    top_level_names = {line.split("/")[0] for line in git_lines("ls-files")}
    top_level_names |= {p.name for p in REPO_ROOT.iterdir() if p.name == ".agents"}
    docs = sorted({doc for glob in DOC_GLOBS for doc in REPO_ROOT.glob(glob)})
    problem_count = 0
    for doc in docs:
        for line_number, problem in broken_references(doc, top_level_names):
            print(f"{doc.relative_to(REPO_ROOT)}:{line_number}: {problem}")
            problem_count += 1
    if problem_count:
        sys.exit(f"{problem_count} broken reference(s) in {len(docs)} file(s)")
    print(f"OK: {len(docs)} file(s) checked")


if __name__ == "__main__":
    main()
