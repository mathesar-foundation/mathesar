ALLOWED_HOSTS=".localhost, 127.0.0.1, [::1]"
# OIDC_CONFIG_DICT is the legacy name for SSO_CONFIG_DICT and is still accepted.
SSO_CONFIG_DICT="{\"version\": 2,\"providers\": {  \"provider1\": {    \"type\": \"oidc\",    \"provider_name\": \"okta\",    \"client_id\": \"client-id\",    \"secret\": null,    \"server_url\": \"https://trial-2872264-admin.okta.com\"  }}}"
PER_USER_DATABASES_ENABLED=false
# Datafiles storage: 'local' (default) or 'azure'. Uncomment and set the
# variables below to store uploaded datafiles in Azure Blob Storage.
# Authentication uses DefaultAzureCredential, which resolves credentials from
# the environment (managed identity, workload identity, `az login`, etc.).
# DATA_FILES_STORAGE_BACKEND=azure
# DATA_FILES_AZURE_ACCOUNT_NAME=
# DATA_FILES_AZURE_CONTAINER=mathesar-datafiles
# Optional: Links shown at the bottom of the login page. If unset, no links display.
# MATHESAR_TERMS_OF_SERVICE_URL=https://example.com/terms
# MATHESAR_PRIVACY_POLICY_URL=https://example.com/privacy
