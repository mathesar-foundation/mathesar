# Source this file: `source agents/bin/dev-env`
#
# Exports the environment for running Mathesar from source without Docker.
# Values mirror the `dev-service` block of docker-compose.dev.yml.
# Any variable already set in the calling shell wins.

export MODE="${MODE:-DEVELOPMENT}"
export DEBUG="${DEBUG:-True}"
export DJANGO_SETTINGS_MODULE="${DJANGO_SETTINGS_MODULE:-config.settings.development}"
export ALLOWED_HOSTS="${ALLOWED_HOSTS:-*}"
export SKIP_STATIC_COLLECTION="${SKIP_STATIC_COLLECTION:-true}"
export DJANGO_SUPERUSER_PASSWORD="${DJANGO_SUPERUSER_PASSWORD:-password}"

# Mathesar's internal database (Django models, users, saved explorations).
export POSTGRES_DB="${POSTGRES_DB:-mathesar_django}"
export POSTGRES_USER="${POSTGRES_USER:-mathesar}"
export POSTGRES_PASSWORD="${POSTGRES_PASSWORD:-mathesar}"
export POSTGRES_HOST="${POSTGRES_HOST:-localhost}"
export POSTGRES_PORT="${POSTGRES_PORT:-5432}"

# Used by agents/bin/rpc, agents/bin/seed and agents/bin/screenshot.
export MATHESAR_URL="${MATHESAR_URL:-http://localhost:${MATHESAR_PORT:-8000}}"
export MATHESAR_USER="${MATHESAR_USER:-admin}"
export MATHESAR_PASSWORD="${MATHESAR_PASSWORD:-$DJANGO_SUPERUSER_PASSWORD}"
