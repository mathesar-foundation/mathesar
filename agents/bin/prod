#!/usr/bin/env bash
# Run the production Docker Compose setup (docker-compose.yml) with images built
# from this working tree. Use it to find problems that the dev servers hide.
#
# Usage: agents/bin/prod <command>
#   up [--release <version>] [--no-admin]
#       Build the service and Caddy images, start the stack, create the user
#       admin / password. Safe to re-run: it rebuilds and replaces the containers
#       and keeps the data.
#       --release <version>  Run the published images of that version instead of
#                            building (start point for an upgrade test).
#       --no-admin           Create no user, to test the first-run installation page.
#   down             Stop the stack. Data is kept.
#   reset            Stop the stack and delete its data.
#   status           List the containers.
#   logs [service]   Show recent logs: service, db or caddy-reverse-proxy.
#
# The app is served at http://localhost (port 80). To use the other scripts with
# it: export MATHESAR_URL=http://localhost
# Data lives in $MATHESAR_PROD_DIR (default /tmp/mathesar-prod).
set -euo pipefail

# shellcheck source=agents/bin/_common
source "$(dirname "${BASH_SOURCE[0]}")/_common"

PROD_DIR="${MATHESAR_PROD_DIR:-${TMPDIR:-/tmp}/mathesar-prod}"
PROD_URL=http://localhost
ADMIN_PASSWORD="${MATHESAR_PASSWORD:-password}"
LOCAL_TAG=agents-local

usage() { sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

# Values for the stack go in $PROD_DIR/.env. The dev settings never reach compose.
compose() {
  without_dev_env docker compose -p mathesar-prod --project-directory "$PROD_DIR" \
    -f "$REPO_ROOT/docker-compose.yml" -f "$PROD_DIR/override.yml" "$@"
}

require_stack() {
  [ -f "$PROD_DIR/override.yml" ] || die "No production stack found in $PROD_DIR. Run: agents/bin/prod up"
}

build_images() {
  local context_tar="$PROD_DIR/build-context.tar"
  prepare_docker_build
  write_build_context "$context_tar"
  log "Building mathesar/mathesar:$LOCAL_TAG (target production). Log: $PROD_DIR/build-service.log"
  docker build "${DOCKER_BUILD_FLAGS[@]}" --build-arg "PYTHON_VERSION=$PYTHON_BASE_TAG" --target production \
    -t "mathesar/mathesar:$LOCAL_TAG" - <"$context_tar" >"$PROD_DIR/build-service.log" 2>&1 \
    || { tail -n 40 "$PROD_DIR/build-service.log" >&2; die "the service image build failed"; }
  log "Building mathesar/mathesar-caddy:$LOCAL_TAG. Log: $PROD_DIR/build-caddy.log"
  docker build "${DOCKER_BUILD_FLAGS[@]}" --build-arg "BASE_IMAGE=python:$PYTHON_BASE_TAG" -f Dockerfile.caddy \
    -t "mathesar/mathesar-caddy:$LOCAL_TAG" - <"$context_tar" >"$PROD_DIR/build-caddy.log" 2>&1 \
    || { tail -n 40 "$PROD_DIR/build-caddy.log" >&2; die "the Caddy image build failed"; }
  rm -f "$context_tar"
}

# Production settings hardcode the analytics URLs. The extra_hosts entry keeps a
# test stack from reporting to the project's real analytics server.
write_compose_override() {
  local tag=$1 pull_policy=$2
  cat >"$PROD_DIR/override.yml" <<EOF
services:
  service:
    image: mathesar/mathesar:$tag
    pull_policy: $pull_policy
    extra_hosts:
      - "analytics.mathesar.dev:127.0.0.1"
  caddy-reverse-proxy:
    image: mathesar/mathesar-caddy:$tag
    pull_policy: $pull_policy
EOF
}

create_admin_user() {
  local output
  if output=$(docker exec -e DJANGO_SUPERUSER_PASSWORD="$ADMIN_PASSWORD" mathesar_service \
      python manage.py createsuperuser --no-input --username admin --email admin@example.com 2>&1); then
    log "Created Mathesar user 'admin' (password: $ADMIN_PASSWORD)"
  elif [[ "$output" != *"already taken"* ]]; then
    die "could not create the admin user: $output"
  fi
}

up() {
  local release="" create_admin=true
  while [ $# -gt 0 ]; do
    case "$1" in
      --release) release=${2:?--release needs a version, for example 0.12.0}; shift ;;
      --no-admin) create_admin=false ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done
  ensure_docker_running
  mkdir -p "$PROD_DIR"
  if [ -n "$release" ]; then
    write_compose_override "$release" missing
  else
    build_images
    write_compose_override "$LOCAL_TAG" never
  fi
  log "Starting the stack"
  compose up -d --wait --wait-timeout 300 \
    || { compose logs --tail 40 service >&2; die "the stack did not become healthy"; }
  if [ "$create_admin" = true ]; then create_admin_user; fi
  log "Mathesar (production setup) is running at $PROD_URL"
  log "Use the other scripts with it: export MATHESAR_URL=$PROD_URL"
}

command=${1:-}
shift || true
case "$command" in
  up) up "$@" ;;
  down) require_stack; compose down ;;
  reset)
    if [ -f "$PROD_DIR/override.yml" ] && docker info >/dev/null 2>&1; then
      compose down --volumes --remove-orphans
    fi
    # Containers write these as other users, so removing them can need root.
    as_root rm -rf "$PROD_DIR/msar" "$PROD_DIR/override.yml" "$PROD_DIR"/build-*.log
    rmdir "$PROD_DIR" 2>/dev/null || true
    log "Removed the stack data in $PROD_DIR"
    ;;
  status) require_stack; compose ps ;;
  logs) require_stack; compose logs --tail 200 "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
