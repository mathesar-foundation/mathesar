#!/usr/bin/env python3
"""
Check that the branch, its commits and the PR text carry no trace of a coding agent.

Fails on:
- A branch name that is not `<type>/<short-description>`, or that names an agent.
- An author or committer name or email that names an agent or a bot.
- A `Co-authored-by` trailer that names an agent or a bot.
- A session trailer, a session link or a "Generated with" line added by an agent harness.

Usage: agents/bin/check-git [--base <ref>] [--text <file> ...]
  Checks the current branch name and the commits in base..HEAD. The base
  defaults to $MATHESAR_BASE_REF, then origin/develop.
  --text also checks a file that holds a PR title and description.
Exits 1 and lists each problem.
"""
import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[2]

AGENT_PRODUCTS = (
    r"claude|anthropic|copilot|codex|openai|chatgpt|cursor|devin|aider|gemini|jules"
    r"|windsurf|codeium|amazon q|sourcegraph|cody"
)
AGENT_NAMES = AGENT_PRODUCTS + r"|\[bot\]|\bbot\b|\bagent\b"
AGENT_IDENTITY = re.compile(AGENT_NAMES, re.IGNORECASE)
# Narrower than AGENT_PRODUCTS: words such as "cursor" are common in branch names here.
AGENT_IN_BRANCH_NAME = re.compile(r"claude|anthropic|copilot|codex|openai|chatgpt", re.IGNORECASE)
MESSAGE_RULES = [
    (
        re.compile(rf"^\s*co-authored-by:.*({AGENT_NAMES})", re.IGNORECASE),
        "co-author trailer names an agent",
    ),
    (
        re.compile(r"^\s*[a-z]+-session(-id)?:\s*\S+", re.IGNORECASE),
        "session trailer from an agent harness",
    ),
    (
        re.compile(
            rf"(generated|created|written|authored)\s+(with|by)\b.*({AGENT_NAMES})",
            re.IGNORECASE,
        ),
        "line credits an agent",
    ),
    (re.compile("\N{ROBOT FACE}"), "line credits an agent"),
    (
        re.compile(r"https?://(www\.)?(claude\.ai|chatgpt\.com|chat\.openai\.com)/", re.IGNORECASE),
        "link to an agent session",
    ),
]

BRANCH_TYPES = ("fix", "feat", "chore", "docs", "refactor", "test", "perf", "build", "ci")
BRANCH_NAME = re.compile(rf"^({'|'.join(BRANCH_TYPES)})/[a-z0-9]+(-[a-z0-9]+)*$")
LONG_LIVED_BRANCH = re.compile(r"^(develop|master|release-[\d.]+)$")

FIELD_SEPARATOR = "\x1f"
RECORD_SEPARATOR = "\x1e"
LOG_FORMAT = FIELD_SEPARATOR.join(["%h", "%an", "%ae", "%cn", "%ce", "%B"]) + RECORD_SEPARATOR


def git(*args):
    result = subprocess.run(
        ["git", *args], cwd=REPO_ROOT, capture_output=True, text=True
    )
    if result.returncode != 0:
        sys.exit(f"error: git {' '.join(args)}: {result.stderr.strip()}")
    return result.stdout


def commits_since(base):
    log = git("log", f"--format={LOG_FORMAT}", f"{base}..HEAD")
    for record in log.split(RECORD_SEPARATOR):
        if record.strip():
            yield record.strip("\n").split(FIELD_SEPARATOR)


def problems_in_text(text):
    for line in text.splitlines():
        for pattern, problem in MESSAGE_RULES:
            if pattern.search(line):
                yield f"{problem}: {line.strip()}"
                break


def problems_in_commit(author_name, author_email, committer_name, committer_email, message):
    identities = [
        ("author", f"{author_name} <{author_email}>"),
        ("committer", f"{committer_name} <{committer_email}>"),
    ]
    for role, identity in identities:
        if AGENT_IDENTITY.search(identity):
            yield f"{role} names an agent: {identity}"
    yield from problems_in_text(message)


def problems_in_branch_name(branch):
    """The branch name is checked only on a work branch, not on a detached HEAD."""
    if not branch or LONG_LIVED_BRANCH.match(branch):
        return
    if AGENT_IN_BRANCH_NAME.search(branch):
        yield "name contains the name of an agent product"
    if not BRANCH_NAME.match(branch):
        yield (
            f"name is not <type>/<short-description> in lowercase with hyphens, "
            f"where type is one of: {', '.join(BRANCH_TYPES)}"
        )


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--base", default=os.environ.get("MATHESAR_BASE_REF", "origin/develop"))
    parser.add_argument("--text", action="append", default=[], metavar="FILE")
    args = parser.parse_args()

    problems = []
    branch = git("branch", "--show-current").strip()
    problems += [f"branch {branch}: {p}" for p in problems_in_branch_name(branch)]
    commit_count = 0
    for short_hash, *fields in commits_since(args.base):
        commit_count += 1
        problems += [f"commit {short_hash}: {p}" for p in problems_in_commit(*fields)]
    for text_file in args.text:
        text = Path(text_file).read_text(encoding="utf-8")
        problems += [f"{text_file}: {p}" for p in problems_in_text(text)]

    for problem in problems:
        print(problem)
    if problems:
        sys.exit(
            f"{len(problems)} problem(s). See 'Your branch', 'Commits' and 'The PR' "
            "in agents/docs/00-general/workflow.md"
        )
    checked = [f"branch {branch or '(detached)'}", f"{commit_count} commit(s) against {args.base}"]
    checked += args.text
    print(f"OK: {', '.join(checked)}")


if __name__ == "__main__":
    main()
