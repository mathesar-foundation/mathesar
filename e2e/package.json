{
  "name": "mathesar-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end tests that drive a production Mathesar instance through the browser",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "report": "playwright show-report",
